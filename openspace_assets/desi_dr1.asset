-- =================================================================
-- DESI FULL SURVEY
-- =================================================================

local full_identifier = "DESI_DR1_Catalog"
local full_csv_file = "desi_catalog_indexed_0-2-0.csv"
local full_gui_name = "DESI DR1 Full Survey"

-- =================================================================

local Node = {
    Identifier = full_identifier,
    Parent = "Root",
    Enabled = false, -- Starts turned OFF (unchecked) for planetarium shows
    Renderable = {
        Type = "RenderablePointCloud",
        File = asset.resource(full_csv_file),
        Unit = "Mpc", 
        
        DataMapping = {
            X = "x",
            Y = "y",
            Z = "z"
        },
        
        Coloring = {
            ColorMapping = {
                File = asset.resource("lupton_palette.cmap"),
                Parameter = "color_id", 
                ParameterOptions = {
                    { 
                        Key = "color_id", 
                        Range = { 0.0, 999.0 } 
                    }
                }
            }
        },
        
        -- NEW: Texture Mapping reads your .tmap file and assigns shapes
        TextureMapping = {
            File = asset.resource("galaxy_sprites.tmap"),
            Parameter = "object_subtype"
        },
        
        -- UPDATED: Scale block controls physical size and glowing brightness
        Scale = {
            ScaleColumn = "size_scale",
            ScaleExponent = 1.0,
            ScaleFactor = 1.0 -- Standard multiplier to ensure the scale triggers
        }
    },
    GUI = {
        Name = full_gui_name,
        Path = "/Universe/Galaxies/DESI"
    }
}

asset.onInitialize(function()
    openspace.addSceneGraphNode(Node)
end)

asset.onDeinitialize(function()
    openspace.removeSceneGraphNode(Node)
end)