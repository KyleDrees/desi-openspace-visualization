local Node = {
    Identifier = "DESI_DR1_Catalog",
    Parent = "Root",
    Renderable = {
        Type = "RenderablePointCloud",
        -- Make sure this matches your exact CSV filename!
        File = asset.resource("desi_catalog_indexed_0-2-0.csv"),
        Unit = "Mpc", 
        
        DataMapping = {
            X = "x",
            Y = "y",
            Z = "z"
        },
        
        Coloring = {
            ColorMapping = {
                File = asset.resource("lupton_palette.cmap"),
                -- Adding this line to match your friend's explicit syntax
                Parameter = "color_id", 
                ParameterOptions = {
                    { 
                        Key = "color_id", 
                        Range = { 0.0, 999.0 } 
                    }
                }
            }
        },
        
        Scale = {
            ScaleColumn = "size_scale",
            ScaleExponent = 1.0
        }
    },
    GUI = {
        Name = "DESI DR1 Full Survey",
        Path = "/Universe/Galaxies/DESI"
    }
}

asset.onInitialize(function()
    openspace.addSceneGraphNode(Node)
end)

asset.onDeinitialize(function()
    openspace.removeSceneGraphNode(Node)
end)