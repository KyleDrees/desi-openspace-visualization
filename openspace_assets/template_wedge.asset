-- =================================================================
-- DESI WEDGE TEMPLATE
-- Copy this file for each new wedge and change the 3 variables below!
-- =================================================================

local wedge_identifier = "DESI_Wedge_1"
local wedge_csv_file = "wedge_RA0-30_DEC-10-10_Z0.01-0.5.csv"
local wedge_gui_name = "Wedge 1 (RA 0-30)"

-- =================================================================

local Node = {
    Identifier = wedge_identifier,
    Parent = "Root",
    Renderable = {
        Type = "RenderablePointCloud",
        File = asset.resource(wedge_csv_file),
        Unit = "Mpc", 
        
        DataMapping = {
            X = "x",
            Y = "y",
            Z = "z"
        },
        
        Coloring = {
            ColorMapping = {
                File = asset.resource("lupton_palette.cmap"),
                Parameter = "color_id", 
                ParameterOptions = {
                    { 
                        Key = "color_id", 
                        Range = { 0.0, 999.0 } 
                    }
                }
            }
        },
        
        Scale = {
            -- Note: We will map this properly when we add Torston's data!
            ScaleColumn = "size_scale", 
            ScaleExponent = 1.0
        }
    },
    GUI = {
        Name = wedge_gui_name,
        -- This puts all your wedges into a neat subfolder in the OpenSpace menu!
        Path = "/Universe/Galaxies/DESI Wedges" 
    }
}

asset.onInitialize(function()
    openspace.addSceneGraphNode(Node)
end)

asset.onDeinitialize(function()
    openspace.removeSceneGraphNode(Node)
end)